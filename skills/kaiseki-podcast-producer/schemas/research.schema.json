{
  "type": "object",
  "required": [
    "topic",
    "plan",
    "facts",
    "stories",
    "musicPool",
    "topics",
    "conflicts",
    "unconfirmed",
    "gaps",
    "sources"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 20
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "factIds",
          "sourceUrls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^A[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "sourceUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 8
    },
    "musicPool": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/song"
      },
      "minItems": 10
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "支撑"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^T[1-9][0-9]*$"
          },
          "中心论点": {
            "type": "string",
            "minLength": 1
          },
          "概念命题": {
            "type": "string",
            "minLength": 1
          },
          "支撑": {
            "type": "object",
            "required": [
              "事实",
              "轶事",
              "歌曲"
            ],
            "properties": {
              "事实": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "轶事": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "歌曲": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "核心意象候选": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unconfirmed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaiseki.radio/schemas/research-pack-portable.json",
  "$defs": {
    "song": {
      "type": "object",
      "required": [
        "songId",
        "title",
        "artist"
      ],
      "properties": {
        "songId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^S[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "releaseYear": {
          "type": [
            "string",
            "integer"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSource": {
          "type": "string",
          "minLength": 1
        },
        "recordingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "platformLinks": {
          "type": "object",
          "required": [
            "apple",
            "netease",
            "qq",
            "youtube",
            "spotify"
          ],
          "properties": {
            "apple": {
              "type": [
                "string",
                "null"
              ]
            },
            "netease": {
              "type": [
                "string",
                "null"
              ]
            },
            "qq": {
              "type": [
                "string",
                "null"
              ]
            },
            "youtube": {
              "type": [
                "string",
                "null"
              ]
            },
            "spotify": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "missingPlatformReasons": {
          "type": "object",
          "required": [],
          "properties": {
            "apple": {
              "type": "string"
            },
            "netease": {
              "type": "string"
            },
            "qq": {
              "type": "string"
            },
            "youtube": {
              "type": "string"
            },
            "spotify": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lyrics": {
          "type": "string"
        },
        "lyricsFile": {
          "type": "string",
          "minLength": 1
        },
        "lyricsSource": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "sourceId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "purpose": {
          "type": "string"
        },
        "playback": {
          "type": "object",
          "required": [
            "provider",
            "providerTrackId"
          ],
          "properties": {
            "provider": {
              "enum": [
                "netease",
                "youtube"
              ]
            },
            "providerTrackId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "vocalStartEstimateSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "timingNotes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": [
        "id",
        "text",
        "type",
        "confidence",
        "sourceUrls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^F[0-9]{2,}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "事实",
            "引语",
            "数据"
          ]
        },
        "confidence": {
          "enum": [
            "双源确认",
            "单源可信",
            "孤证存疑",
            "传闻"
          ]
        },
        "sourceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        },
        "conflicted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
